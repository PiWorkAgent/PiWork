{
  "name": "piwork",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "keywords": [
    "ai",
    "coding-assistant",
    "electron",
    "react",
    "desktop-app",
    "ai-programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PiWorkAgent/PiWork.git"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev:web": "turbo run dev --filter=@pi/web",
    "dev:desktop": "turbo run dev --filter=@pi/desktop",
    "dev:desktop:plugins": "node scripts/dev-plugin.mjs",
    "dev:desktop:raw": "turbo run dev --filter=@pi/desktop",
    "diag:sessions": "node scripts/diagnostics/session-report.mjs",
    "diag:sessions:all": "node scripts/diagnostics/session-report.mjs --all --limit 500",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean",
    "pack:mac": "cd apps/desktop && pnpm pack:mac",
    "pack:win": "cd apps/desktop && pnpm pack:win",
    "pack:win:cross": "cd apps/desktop && pnpm pack:win:cross",
    "pack:linux": "cd apps/desktop && pnpm pack:linux",
    "pack:all": "cd apps/desktop && pnpm pack:all"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "win32",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    },
    "overrides": {
      "@types/node": "26.6.6"
    }
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
