{
  "name": "@pi/desktop",
  "version": "0.4.7",
  "private": true,
  "main": "./out/main/index.mjs",
  "description": "PiWork - Desktop Application",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/support/register.mjs --test \"tests/**/*.test.mjs\"",
    "clean": "node ../../scripts/clean.mjs out dist",
    "start": "electron .",
    "pack:mac": "pnpm build && node scripts/run-pack.cjs --mac",
    "pack:win": "pnpm build && node scripts/download-bash-bundle.cjs && node scripts/run-pack.cjs --win",
    "pack:win:cross": "pnpm build && node scripts/download-bash-bundle.cjs && node scripts/run-pack.cjs --win --config.win.signAndEditExecutable=false",
    "pack:linux": "pnpm build && node scripts/run-pack.cjs --linux",
    "pack:all": "pnpm build && node scripts/download-bash-bundle.cjs && node scripts/run-pack.cjs --mac --win --linux"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@pi/sdk-wrapper": "workspace:*",
    "@pi/types": "workspace:*",
    "@pi/ui": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "adm-zip": "0.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sherpa-onnx-node": "^2.0.1",
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.6.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.3.8",
    "@tailwindcss/postcss": "^4.3.5"
  },
  "author": "PiWork <pi@example.com>",
  "homepage": "https://github.com/PiWorkAgent/PiWork"
}
